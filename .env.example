# Vercel Environment Variables for Admin Panel
# Set these in Vercel Dashboard > Settings > Environment Variables

# GitHub Personal Access Token (classic) with 'repo' scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub repository in format: owner/repo
GITHUB_REPO=niellevlogsyt/Doba-portfolio

# Branch to commit to (default: main)
GITHUB_BRANCH=main

# Path to content.json in the repo (default: content.json)
GITHUB_FILE_PATH=content.json

# Admin Authentication (Edge Middleware - works on Free tier!)
# Generate password hash: 
#   1. Pick a pepper: openssl rand -hex 16
#   2. Pick a password
#   3. Compute: echo -n "your_passwordYOUR_PEPPER" | sha256sum
#   4. Store hash as ADMIN_PASSWORD_HASH, pepper as ADMIN_PASSWORD_PEPPER
ADMIN_PASSWORD_HASH=your_sha256_hash_here
ADMIN_PASSWORD_PEPPER=your_random_pepper_here

# Optional: Extra secret for API authentication
# ADMIN_API_SECRET=your-random-secret-here